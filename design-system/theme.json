      ["fg-default", "bg-subtle-hover", "text"],
      ["brand-fg", "brand-subtle-hover", "text"],
      ["accent-fg", "accent-subtle-hover", "text"],
      ["success-fg", "success-subtle-hover", "text"],
      ["warning-fg", "warning-subtle-hover", "text"],
