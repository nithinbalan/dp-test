{
  "$schema": "./theme.schema.json",
  "note": "THE single source of truth for every visual value. Hand-maintained; this is design policy, not code. `pnpm ds:tokens` generates primitive.css, semantic.css, the Tailwind theme and tokens.ts from it. Never edit those — edit this. To rebrand, change `palettes.brand.hue` (primary) and `palettes.accent.hue` (accent); everything else follows, in BOTH themes, and the contrast gate below fails the build if legibility breaks. EXCEPTION — theme-invariant roles: `bg-inverse`, `bg-inverse-subtle`, `border-inverse`, `fg-inverse`, `fg-inverse-subtle` (the sidebar/auth-panel chrome) and `accent-solid`, `accent-solid-hover` plus their paired `fg-on-accent` are deliberately given the SAME value in both `semantic.light` and `semantic.dark` — light/dark mode is a body-canvas preference (bg-canvas, bg-surface, fg-default, and friends), not a restyle of the product's fixed brand chrome. `brand-solid` stays theme-swapping, unlike `accent-solid`: `fg-on-brand` is shared with `success-solid`/`info-solid` (see `contrast.pairs`), which DO need to keep adapting per theme, so freezing `brand-solid`'s paired text would silently break their legibility in dark mode — giving `brand-solid` its own dedicated paired-text role is a larger, deliberate follow-up, not a value flip here. `brand-subtle`/`accent-subtle` and their paired `brand-fg`/`accent-fg` still swap too: those render as plain text or a tint directly on the swapping canvas, so they must track it for contrast.",
  "palettes": {
    "brand": {
      "hue": 161,
      "chroma": 0.083,
      "description": "Primary. Deep forest green. Change this hue to rebrand the product."
    },
    "accent": {
      "hue": 120,
      "chroma": 0.26,
      "description": "Accent. Lime highlight used sparingly — active marks, AI affordances, emphasis on dark surfaces. Always carries dark text (fg-on-accent), never white."
    },
    "neutral": {
      "hue": 136,
      "chroma": 0.017,
      "description": "Text, surfaces, borders. A forest-green cast (not a true grey) so ink text and inverse surfaces read as the brand's dark forest rather than generic black."
    },
    "success": {
      "hue": 155,
      "chroma": 0.15
    },
    "warning": {
      "hue": 60,
      "chroma": 0.15
    },
    "danger": {
      "hue": 33,
      "chroma": 0.17
    },
    "info": {
      "hue": 256,
      "chroma": 0.095
    }
  },
