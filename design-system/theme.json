  "contrast": {
    "note": "Checked in BOTH themes by `pnpm ds:tokens --check`. This is what makes changing a hue safe: if a rebrand breaks legibility, the build fails instead of shipping.",
    "minimums": {
      "text": 4.5,
      "largeText": 3,
      "ui": 3
    },
    "pairs": [
      ["fg-default", "bg-canvas", "text"],
      ["fg-default", "bg-surface", "text"],
      ["fg-default", "bg-subtle", "text"],
      ["fg-default", "bg-hover", "text"],
      ["fg-muted", "bg-canvas", "text"],
      ["fg-muted", "bg-surface", "text"],
      ["fg-muted", "bg-hover", "text"],
      ["fg-subtle", "bg-canvas", "largeText"],
      ["fg-inverse", "bg-inverse", "text"],
      ["fg-on-brand", "brand-solid", "text"],
      ["fg-on-brand", "brand-solid-hover", "text"],
      ["fg-on-brand", "success-solid", "text"],
      ["fg-on-brand", "info-solid", "text"],
      ["fg-on-accent", "accent-solid", "text"],
      ["fg-on-accent", "accent-solid-hover", "text"],
      ["fg-on-warning", "warning-solid", "text"],
      ["fg-on-danger", "danger-solid", "text"],
      ["brand-fg", "brand-subtle", "text"],
      ["brand-fg", "bg-canvas", "text"],
      ["accent-fg", "accent-subtle", "text"],
      ["success-fg", "success-subtle", "text"],
      ["warning-fg", "warning-subtle", "text"],
      ["danger-fg", "danger-subtle", "text"],
