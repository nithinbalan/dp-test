# ---------------------------------------------------------------------------
# Copy to .env.local. NEVER commit a filled-in copy. See docs/SECURITY_HYGIENE.md §2.
# Every variable here must also be declared in src/shared/config/env.ts,
# which validates them at boot — an unvalidated env var is a runtime landmine.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Postgres. The app connects as a LOW-PRIVILEGE role that cannot CREATE SCHEMA.
# Provisioning (new workspace schemas) uses a separate migration role.
# See README.md for local setup SQL commands and role explanations.
DATABASE_URL=postgres://app_user:change_me@localhost:5432/jethur_dpdp
DATABASE_MIGRATION_URL=postgres://migrator:change_me@localhost:5432/jethur_dpdp

# postgres://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

# Workspace resolution: 'subdomain' | 'path' | 'header' — see docs/WORKSPACE_ISOLATION.md §3
WORKSPACE_RESOLUTION_STRATEGY=subdomain
APP_BASE_DOMAIN=localhost:3000

# Network: trailing X-Forwarded-For entries written by proxies you control.
# 0 disables per-IP rate limiting (headers are then treated as attacker-controlled).
TRUSTED_PROXY_HOPS=1

# Observability
LOG_LEVEL=info
